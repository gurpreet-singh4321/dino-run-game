<footer class="footer">
  <div class="section-container footer-content">
    <div class="footer-left">
      <div class="logo-box">
        <span class="logo-icon">🦖</span>
        <span class="logo-title">DINO RUN</span>
        <span class="epochs-badge">EPOCHS</span>
      </div>
      <p>© 2026 Dino Run Epochs. Built with Astro JS & Flame Engine.</p>
    </div>
    <div class="footer-right">
      <a href="#play">Play Game</a>
      <a href="#biomes">Biomes</a>
      <a href="#leaderboard">Leaderboard</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-card);
    padding: 40px 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .logo-box {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .logo-icon {
    font-size: 22px;
    line-height: 1;
  }

  .logo-title {
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 1.2px;
    color: #FFFFFF;
    line-height: 1;
  }

  .epochs-badge {
    font-size: 10px;
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-magenta));
    color: #0B0F19;
    padding: 3px 8px;
    border-radius: 16px;
    line-height: 1;
  }

  .footer-left p {
    color: var(--text-muted);
    font-size: 13px;
    margin-top: 8px;
  }

  .footer-right {
    display: flex;
    gap: 20px;
  }

  .footer-right a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease;
  }

  .footer-right a:hover {
    color: var(--accent-cyan);
  }
</style>
