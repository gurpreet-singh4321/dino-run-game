---
---

<section id="play" class="game-section">
  <div class="section-container">
    <div class="game-header-info">
      <h1 class="main-title">DINO RUN: <span class="gradient-text">EPOCHS</span></h1>
      <p class="subtitle">Run across prehistoric lands, survive lava eruptions, and blast into zero-gravity space!</p>
    </div>

    <!-- Embedded Flutter Game Player -->
    <div class="game-wrapper">
      <div class="game-toolbar">
        <div class="toolbar-left">
          <span class="status-dot"></span>
          <span class="toolbar-title">LIVE GAME SESSION (ASTRO JS)</span>
        </div>
        <div class="toolbar-right">
          <button id="btn-fullscreen" class="tool-btn" title="Toggle Fullscreen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            <span>Fullscreen</span>
          </button>
        </div>
      </div>

      <div class="game-frame-box">
        <iframe id="game-frame" src="/game/index.html" title="Dino Run Epochs Game" allow="autoplay; fullscreen"></iframe>
      </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="stats-bar">
      <div class="stat-card">
        <span class="stat-label">LOCAL HIGH SCORE</span>
        <span id="stat-high-score" class="stat-value">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">TOTAL COINS COLLECTED</span>
        <span id="stat-total-coins" class="stat-value">🪙 0</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">TIME EPOCHS</span>
        <span class="stat-value">7 BIOMES</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnFullscreen = document.getElementById('btn-fullscreen');
    const gameFrame = document.getElementById('game-frame') as HTMLIFrameElement;
    const statHighScore = document.getElementById('stat-high-score');
    const statTotalCoins = document.getElementById('stat-total-coins');

    function updateStatsDisplay() {
      const highScore = localStorage.getItem('dino_high_score') || '0';
      const coins = localStorage.getItem('dino_coins') || '0';

      if (statHighScore) statHighScore.textContent = Number(highScore).toLocaleString();
      if (statTotalCoins) statTotalCoins.textContent = `🪙 ${Number(coins).toLocaleString()}`;
    }

    updateStatsDisplay();

    if (btnFullscreen && gameFrame) {
      btnFullscreen.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          if (gameFrame.requestFullscreen) {
            gameFrame.requestFullscreen();
          }
        } else {
          if (document.exitFullscreen) {
            document.exitFullscreen();
          }
        }
      });
    }

    window.addEventListener('message', (event) => {
      if (!event.data) return;

      if (event.data.type === 'DINO_GAME_OVER' || event.data.type === 'STATS_UPDATE') {
        if (event.data.highScore) {
          const currentHigh = Number(localStorage.getItem('dino_high_score') || 0);
          if (event.data.highScore > currentHigh) {
            localStorage.setItem('dino_high_score', event.data.highScore.toString());
          }
        }
        if (event.data.coins !== undefined) {
          localStorage.setItem('dino_coins', event.data.coins.toString());
        }
        updateStatsDisplay();
      }
    });
  });
</script>

<style>
  .game-section {
    padding: 40px 0 60px;
    text-align: center;
  }

  .main-title {
    font-size: 48px;
    font-weight: 900;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 18px;
    max-width: 700px;
    margin: 0 auto 36px;
  }

  .game-wrapper {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(0, 229, 255, 0.1);
    margin-bottom: 30px;
  }

  .game-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid var(--border-card);
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    background-color: var(--accent-green);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-green);
  }

  .toolbar-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--text-muted);
  }

  .tool-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-main);
    border: 1px solid var(--border-card);
    padding: 6px 14px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tool-btn:hover {
    background: var(--accent-cyan);
    color: #000;
  }

  .game-frame-box {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .game-frame-box iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    padding: 20px;
    text-align: center;
  }

  .stat-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 1px;
    margin-bottom: 6px;
  }

  .stat-value {
    font-size: 24px;
    font-weight: 900;
    color: var(--accent-gold);
  }
</style>
