---
---

<section id="play" class="game-section">
  <div class="section-container">
    <div class="game-header-info">
      <h1 class="main-title">DINO RUN: <span class="gradient-text">EPOCHS</span></h1>
      <p class="subtitle">Run across prehistoric lands, survive lava eruptions, and blast into zero-gravity space!</p>
    </div>

    <!-- Embedded Flutter Game Player Wrapper -->
    <div class="game-wrapper" id="game-wrapper">
      <button id="btn-exit-safari-fs" class="btn-exit-safari" title="Exit Fullscreen">✕ EXIT FULLSCREEN</button>

      <div class="game-toolbar">
        <div class="toolbar-left">
          <span class="status-dot"></span>
          <span class="toolbar-title">LIVE GAME SESSION</span>
        </div>
        <div class="toolbar-right">
          <button id="btn-fullscreen" class="tool-btn" title="Toggle Fullscreen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            <span>Fullscreen</span>
          </button>
        </div>
      </div>

      <div class="game-frame-box" id="game-frame-box">
        <!-- Interactive Overlay Layer -->
        <div id="game-overlay" class="game-overlay">
          <!-- Card 1: Fullscreen Required / Game Paused Prompt -->
          <div id="overlay-fullscreen-card" class="overlay-card">
            <span id="overlay-icon" class="overlay-icon">📱 🎮</span>
            <h2 id="overlay-title">FULLSCREEN LANDSCAPE REQUIRED</h2>
            <p id="overlay-desc">Dino Run: Epochs is optimized for Fullscreen Landscape play. Tap below to launch full screen!</p>
            <button id="btn-launch-mobile" class="btn-mobile-play">
              <span id="btn-launch-text">▶ PLAY IN FULLSCREEN</span>
            </button>
          </div>

          <!-- Card 2: Rotate Device to Landscape Prompt (Used in Fullscreen Portrait) -->
          <div id="overlay-rotate-card" class="overlay-card" style="display: none;">
            <span class="overlay-icon">🔄 📱</span>
            <h2>ROTATE YOUR DEVICE</h2>
            <p>Portrait mode is not supported. Please turn your device horizontally to <strong>Landscape mode</strong> to continue playing!</p>
          </div>
        </div>

        <iframe id="game-frame" data-src="/game/index.html" title="Dino Run Epochs Game" allow="autoplay; fullscreen; orientation"></iframe>
      </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="stats-bar">
      <div class="stat-card">
        <span class="stat-label">LOCAL HIGH SCORE</span>
        <span id="stat-high-score" class="stat-value">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">TOTAL COINS COLLECTED</span>
        <span id="stat-total-coins" class="stat-value">🪙 0</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">TIME EPOCHS</span>
        <span class="stat-value">7 BIOMES</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnFullscreen = document.getElementById('btn-fullscreen');
    const btnLaunchMobile = document.getElementById('btn-launch-mobile');
    const btnExitSafari = document.getElementById('btn-exit-safari-fs');
    const gameFrame = document.getElementById('game-frame') as HTMLIFrameElement;
    const gameWrapper = document.getElementById('game-wrapper') as HTMLElement;
    const gameOverlay = document.getElementById('game-overlay') as HTMLElement;
    const overlayFullscreenCard = document.getElementById('overlay-fullscreen-card') as HTMLElement;
    const overlayRotateCard = document.getElementById('overlay-rotate-card') as HTMLElement;
    const overlayIcon = document.getElementById('overlay-icon') as HTMLElement;
    const overlayTitle = document.getElementById('overlay-title') as HTMLElement;
    const overlayDesc = document.getElementById('overlay-desc') as HTMLElement;
    const btnLaunchText = document.getElementById('btn-launch-text') as HTMLElement;

    const statHighScore = document.getElementById('stat-high-score');
    const statTotalCoins = document.getElementById('stat-total-coins');

    const isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

    let hasExitedFullscreen = false;

    function isMobileView(): boolean {
      return window.innerWidth <= 900 || /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    }

    function isFullscreenActive(): boolean {
      return !!(
        document.fullscreenElement ||
        (document as any).webkitFullscreenElement ||
        (document as any).webkitIsFullScreen ||
        (document as any).mozFullScreenElement ||
        gameWrapper?.classList.contains('safari-fullscreen-active')
      );
    }

    function isPortraitMode(): boolean {
      return window.innerHeight > window.innerWidth;
    }

    function updateStatsDisplay() {
      const highScore = localStorage.getItem('dino_high_score') || '0';
      const coins = localStorage.getItem('dino_coins') || '0';

      if (statHighScore) statHighScore.textContent = Number(highScore).toLocaleString();
      if (statTotalCoins) statTotalCoins.textContent = `🪙 ${Number(coins).toLocaleString()}`;
    }

    updateStatsDisplay();

    function pauseGameEngine() {
      if (gameFrame && gameFrame.contentWindow) {
        try {
          gameFrame.contentWindow.postMessage({ type: 'PAUSE_GAME' }, '*');
        } catch (_) {}
      }
    }

    function syncVisibilityAndState() {
      const inFullscreen = isFullscreenActive();
      const inPortrait = isPortraitMode();
      const inMobile = isMobileView();

      if (inFullscreen) {
        if (inPortrait) {
          // Fullscreen BUT in Portrait -> RESTRICT GAME, SHOW ROTATE PROMPT
          pauseGameEngine();
          if (gameFrame) gameFrame.style.display = 'none';
          if (gameOverlay) gameOverlay.style.display = 'flex';
          if (overlayFullscreenCard) overlayFullscreenCard.style.display = 'none';
          if (overlayRotateCard) overlayRotateCard.style.display = 'flex';
        } else {
          // Fullscreen AND Landscape -> SHOW GAME, HIDE ALL OVERLAYS
          if (gameFrame) {
            const targetSrc = gameFrame.getAttribute('data-src');
            if (targetSrc && !gameFrame.src) {
              gameFrame.src = targetSrc;
            }
            gameFrame.style.display = 'block';
          }
          if (gameOverlay) gameOverlay.style.display = 'none';
          if (overlayFullscreenCard) overlayFullscreenCard.style.display = 'none';
          if (overlayRotateCard) overlayRotateCard.style.display = 'none';
        }
      } else {
        // NOT Fullscreen (e.g. mobile page view, desktop page view after exit fullscreen, etc.)
        if (inMobile || hasExitedFullscreen || inPortrait) {
          // Game must NOT run and must NOT be visible when not in fullscreen (mobile or exited FS)
          pauseGameEngine();
          if (gameFrame) gameFrame.style.display = 'none';
          if (gameOverlay) gameOverlay.style.display = 'flex';
          if (overlayRotateCard) overlayRotateCard.style.display = 'none';
          if (overlayFullscreenCard) {
            overlayFullscreenCard.style.display = 'flex';
            if (hasExitedFullscreen) {
              if (overlayIcon) overlayIcon.textContent = '⏸️ 🎮';
              if (overlayTitle) overlayTitle.textContent = 'GAME PAUSED';
              if (overlayDesc) overlayDesc.textContent = 'Fullscreen mode was exited. The game is paused and hidden. Re-enter fullscreen mode to resume playing!';
              if (btnLaunchText) btnLaunchText.textContent = '▶ RESUME GAME IN FULLSCREEN';
            } else {
              if (overlayIcon) overlayIcon.textContent = '📱 🎮';
              if (overlayTitle) overlayTitle.textContent = 'FULLSCREEN LANDSCAPE REQUIRED';
              if (overlayDesc) overlayDesc.textContent = 'Mobile / non-fullscreen embedded mode is restricted. Tap below to launch the game in fullscreen landscape mode!';
              if (btnLaunchText) btnLaunchText.textContent = '▶ PLAY IN FULLSCREEN';
            }
          }
        } else {
          // Desktop landscape initial view
          if (gameFrame) {
            const targetSrc = gameFrame.getAttribute('data-src');
            if (targetSrc && !gameFrame.src) {
              gameFrame.src = targetSrc;
            }
            gameFrame.style.display = 'block';
          }
          if (gameOverlay) gameOverlay.style.display = 'none';
        }
      }
    }

    async function launchLandscapeFullscreen() {
      if (!gameFrame) return;

      // Ensure iframe src is loaded
      const targetSrc = gameFrame.getAttribute('data-src');
      if (targetSrc && !gameFrame.src) {
        gameFrame.src = targetSrc;
      }

      const container = gameWrapper || gameFrame.parentElement || gameFrame;
      const supportsNativeFullscreen = !!(
        container.requestFullscreen ||
        (container as any).webkitRequestFullscreen ||
        (container as any).mozRequestFullScreen
      );

      if (isIOS || !supportsNativeFullscreen) {
        // Safari iOS Fallback
        if (gameWrapper) {
          gameWrapper.classList.add('safari-fullscreen-active');
        }
        document.body.style.overflow = 'hidden';
      } else {
        try {
          if (container.requestFullscreen) {
            await container.requestFullscreen();
          } else if ((container as any).webkitRequestFullscreen) {
            await (container as any).webkitRequestFullscreen();
          } else if ((container as any).mozRequestFullScreen) {
            await (container as any).mozRequestFullScreen();
          }

          if (screen.orientation && (screen.orientation as any).lock) {
            await (screen.orientation as any).lock('landscape').catch(() => {});
          }
        } catch (err) {
          if (gameWrapper) {
            gameWrapper.classList.add('safari-fullscreen-active');
          }
          document.body.style.overflow = 'hidden';
        }
      }

      syncVisibilityAndState();
    }

    function exitSafariFullscreen() {
      if (gameWrapper) {
        gameWrapper.classList.remove('safari-fullscreen-active');
      }
      document.body.style.overflow = '';
      hasExitedFullscreen = true;
      pauseGameEngine();
      syncVisibilityAndState();
    }

    function handleFullscreenChange() {
      const inFullscreen = isFullscreenActive();

      if (!inFullscreen) {
        hasExitedFullscreen = true;
        pauseGameEngine();
      }

      syncVisibilityAndState();
    }

    // Bind event listeners with vendor prefix support for Safari
    document.addEventListener('fullscreenchange', handleFullscreenChange);
    document.addEventListener('webkitfullscreenchange', handleFullscreenChange);
    document.addEventListener('mozfullscreenchange', handleFullscreenChange);
    document.addEventListener('MSFullscreenChange', handleFullscreenChange);

    window.addEventListener('resize', syncVisibilityAndState);
    window.addEventListener('orientationchange', syncVisibilityAndState);

    if (btnFullscreen) btnFullscreen.addEventListener('click', launchLandscapeFullscreen);
    if (btnLaunchMobile) btnLaunchMobile.addEventListener('click', launchLandscapeFullscreen);
    if (btnExitSafari) btnExitSafari.addEventListener('click', exitSafariFullscreen);

    // Initial state check
    syncVisibilityAndState();

    window.addEventListener('message', (event) => {
      if (!event.data) return;

      if (event.data.type === 'DINO_GAME_OVER' || event.data.type === 'STATS_UPDATE') {
        if (event.data.highScore) {
          const currentHigh = Number(localStorage.getItem('dino_high_score') || 0);
          if (event.data.highScore > currentHigh) {
            localStorage.setItem('dino_high_score', event.data.highScore.toString());
          }
        }
        if (event.data.coins !== undefined) {
          localStorage.setItem('dino_coins', event.data.coins.toString());
        }
        updateStatsDisplay();
      }
    });
  });
</script>

<style>
  .game-section {
    padding: 30px 0 50px;
    text-align: center;
  }

  .main-title {
    font-size: clamp(26px, 5.5vw, 48px);
    font-weight: 900;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: clamp(13px, 3.2vw, 17px);
    max-width: 650px;
    margin: 0 auto 24px;
    padding: 0 16px;
  }

  .game-wrapper {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(0, 229, 255, 0.1);
    margin-bottom: 30px;
  }

  .game-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background: rgba(0, 0, 0, 0.6);
    border-bottom: 1px solid var(--border-card);
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    background-color: var(--accent-green);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-green);
  }

  .toolbar-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--text-muted);
  }

  .tool-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-main);
    border: 1px solid var(--border-card);
    padding: 6px 14px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tool-btn:hover {
    background: var(--accent-cyan);
    color: #000;
  }

  .game-frame-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0B0F19;
    overflow: hidden;
  }

  .game-frame-box iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: none; /* Controlled dynamically via JS */
  }

  /* Fullscreen & Responsive Overlay */
  .game-overlay {
    display: flex;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(11, 15, 25, 0.98);
    backdrop-filter: blur(16px);
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .overlay-card {
    max-width: 420px;
    width: 100%;
    text-align: center;
    background: rgba(18, 26, 42, 0.85);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: 32px 24px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
  }

  .overlay-icon {
    font-size: 48px;
    display: block;
    margin-bottom: 12px;
  }

  .overlay-card h2 {
    font-size: 20px;
    font-weight: 900;
    margin-bottom: 10px;
    color: var(--text-main);
    letter-spacing: 1px;
  }

  .overlay-card p {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .btn-mobile-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 16px 24px;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-magenta));
    color: #0B0F19;
    font-weight: 900;
    font-size: 15px;
    letter-spacing: 1.2px;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 229, 255, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-mobile-play:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 35px rgba(0, 229, 255, 0.5);
  }

  .btn-mobile-play:active {
    transform: scale(0.97);
  }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    padding: 18px;
    text-align: center;
  }

  .stat-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .stat-value {
    font-size: 22px;
    font-weight: 900;
    color: var(--accent-gold);
  }

  /* Safari iOS Viewport Fullscreen Fallback */
  .btn-exit-safari {
    display: none;
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 1000005;
    background: rgba(0, 0, 0, 0.88);
    color: var(--accent-cyan);
    border: 1px solid var(--accent-cyan);
    padding: 8px 18px;
    border-radius: 20px;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 1px;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 229, 255, 0.4);
  }

  .game-wrapper.safari-fullscreen-active {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100% !important;
    height: 100% !important;
    height: 100dvh !important;
    z-index: 1000000 !important;
    border-radius: 0 !important;
    margin: 0 !important;
    border: none !important;
    background: #000 !important;
  }

  .game-wrapper.safari-fullscreen-active .game-toolbar {
    display: none !important;
  }

  .game-wrapper.safari-fullscreen-active .game-frame-box {
    width: 100% !important;
    height: 100% !important;
    height: 100dvh !important;
    aspect-ratio: auto !important;
  }

  .game-wrapper.safari-fullscreen-active .btn-exit-safari {
    display: block !important;
  }

  /* Standard Native Fullscreen & WebKit Fullscreen Rules (Separated for Safari compatibility) */
  .game-wrapper:fullscreen {
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    max-width: 100vw !important;
    border-radius: 0 !important;
    border: none !important;
    margin: 0 !important;
    background: #000 !important;
  }

  .game-wrapper:-webkit-full-screen {
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    max-width: 100vw !important;
    border-radius: 0 !important;
    border: none !important;
    margin: 0 !important;
    background: #000 !important;
  }

  :fullscreen .game-frame-box {
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    aspect-ratio: auto !important;
  }

  :-webkit-full-screen .game-frame-box {
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    aspect-ratio: auto !important;
  }

  :fullscreen .game-toolbar {
    display: none !important;
  }

  :-webkit-full-screen .game-toolbar {
    display: none !important;
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .game-section {
      padding: 16px 0 35px;
    }

    .subtitle {
      margin-bottom: 16px;
    }

    .game-toolbar {
      padding: 10px 14px;
    }

    .toolbar-title {
      font-size: 11px;
    }

    .tool-btn {
      padding: 5px 10px;
      font-size: 12px;
    }

    .overlay-card {
      padding: 24px 16px;
    }

    .overlay-card h2 {
      font-size: 18px;
    }

    .overlay-card p {
      font-size: 13px;
      margin-bottom: 18px;
    }

    .btn-mobile-play {
      padding: 14px 18px;
      font-size: 14px;
    }

    .stats-bar {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .stat-card {
      padding: 10px 6px;
    }

    .stat-label {
      font-size: 9px;
    }

    .stat-value {
      font-size: 15px;
    }
  }

  @media (max-width: 480px) {
    .stats-bar {
      grid-template-columns: 1fr;
    }
  }
</style>


