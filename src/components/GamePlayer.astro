---
---

<section id="play" class="game-section">
  <div class="section-container">
    <div class="game-header-info">
      <h1 class="main-title">DINO RUN: <span class="gradient-text">EPOCHS</span></h1>
      <p class="subtitle">Run across prehistoric lands, survive lava eruptions, and blast into zero-gravity space!</p>
    </div>

    <!-- Embedded Flutter Game Player -->
    <div class="game-wrapper">
      <button id="btn-exit-safari-fs" class="btn-exit-safari" title="Exit Fullscreen">✕ EXIT FULLSCREEN</button>

      <div class="game-toolbar">
        <div class="toolbar-left">
          <span class="status-dot"></span>
          <span class="toolbar-title">LIVE GAME SESSION (ASTRO JS)</span>
        </div>
        <div class="toolbar-right">
          <button id="btn-fullscreen" class="tool-btn" title="Toggle Fullscreen">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            <span>Fullscreen</span>
          </button>
        </div>
      </div>

      <div class="game-frame-box">
        <!-- Mobile Phone Launch Overlay -->
        <div id="mobile-play-overlay" class="mobile-overlay">
          <div class="overlay-card">
            <span class="overlay-icon">📱 🎮</span>
            <h2>LANDSCAPE MODE REQUIRED</h2>
            <p>Portrait mode is restricted for mobile play. Tap below to launch the game in fullscreen landscape mode!</p>
            <button id="btn-launch-mobile" class="btn-mobile-play">
              <span>▶ TAP TO PLAY FULLSCREEN</span>
            </button>
          </div>
        </div>

        <iframe id="game-frame" data-src="/game/index.html" title="Dino Run Epochs Game" allow="autoplay; fullscreen; orientation"></iframe>
      </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="stats-bar">
      <div class="stat-card">
        <span class="stat-label">LOCAL HIGH SCORE</span>
        <span id="stat-high-score" class="stat-value">0</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">TOTAL COINS COLLECTED</span>
        <span id="stat-total-coins" class="stat-value">🪙 0</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">TIME EPOCHS</span>
        <span class="stat-value">7 BIOMES</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnFullscreen = document.getElementById('btn-fullscreen');
    const btnLaunchMobile = document.getElementById('btn-launch-mobile');
    const btnExitSafari = document.getElementById('btn-exit-safari-fs');
    const gameFrame = document.getElementById('game-frame') as HTMLIFrameElement;
    const gameWrapper = document.querySelector('.game-wrapper') as HTMLElement;
    const mobileOverlay = document.getElementById('mobile-play-overlay');
    const statHighScore = document.getElementById('stat-high-score');
    const statTotalCoins = document.getElementById('stat-total-coins');

    const isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const isPortraitOrMobile = window.innerWidth <= 900 || window.innerHeight > window.innerWidth || /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

    // Desktop landscape loads iframe automatically; Mobile / Portrait waits for explicit tap
    if (!isPortraitOrMobile && gameFrame) {
      const targetSrc = gameFrame.getAttribute('data-src');
      if (targetSrc) gameFrame.src = targetSrc;
    }

    function updateStatsDisplay() {
      const highScore = localStorage.getItem('dino_high_score') || '0';
      const coins = localStorage.getItem('dino_coins') || '0';

      if (statHighScore) statHighScore.textContent = Number(highScore).toLocaleString();
      if (statTotalCoins) statTotalCoins.textContent = `🪙 ${Number(coins).toLocaleString()}`;
    }

    updateStatsDisplay();

    async function launchLandscapeFullscreen() {
      if (!gameFrame) return;

      // Ensure iframe is loaded before going fullscreen
      const targetSrc = gameFrame.getAttribute('data-src');
      if (targetSrc && !gameFrame.src) {
        gameFrame.src = targetSrc;
      }

      // Show iframe on mobile when launched
      if (gameFrame) {
        gameFrame.style.display = 'block';
      }

      if (isIOS || !document.fullscreenEnabled) {
        // Safari iOS Fallback: Fullscreen Viewport Container
        if (gameWrapper) {
          gameWrapper.classList.add('safari-fullscreen-active');
        }
        if (mobileOverlay) {
          mobileOverlay.style.display = 'none';
        }
        document.body.style.overflow = 'hidden';
      } else {
        // Standard Fullscreen API for Android / Chrome / Firefox
        try {
          const container = gameFrame.parentElement || gameFrame;
          if (container.requestFullscreen) {
            await container.requestFullscreen();
          } else if ((container as any).webkitRequestFullscreen) {
            await (container as any).webkitRequestFullscreen();
          }

          if (screen.orientation && (screen.orientation as any).lock) {
            await (screen.orientation as any).lock('landscape').catch(() => {});
          }

          if (mobileOverlay) {
            mobileOverlay.style.display = 'none';
          }
        } catch (err) {
          // Safari Fallback on blocked request
          if (gameWrapper) {
            gameWrapper.classList.add('safari-fullscreen-active');
          }
          if (mobileOverlay) {
            mobileOverlay.style.display = 'none';
          }
          document.body.style.overflow = 'hidden';
        }
      }
    }

    function exitSafariFullscreen() {
      if (gameWrapper) {
        gameWrapper.classList.remove('safari-fullscreen-active');
      }
      document.body.style.overflow = '';

      if (gameFrame && gameFrame.contentWindow) {
        try {
          gameFrame.contentWindow.postMessage({ type: 'PAUSE_GAME' }, '*');
        } catch (_) {}
      }

      if (mobileOverlay) {
        mobileOverlay.style.display = 'flex';
        const btnText = mobileOverlay.querySelector('.btn-mobile-play span');
        if (btnText) btnText.textContent = '▶ RESUME GAME IN FULLSCREEN';
        const overlayTitle = mobileOverlay.querySelector('h2');
        if (overlayTitle) overlayTitle.textContent = 'GAME PAUSED';
      }
    }

    function handleFullscreenChange() {
      const isFullscreenNow = !!(
        document.fullscreenElement ||
        (document as any).webkitRequestFullscreen
      );

      if (!isFullscreenNow && !gameWrapper?.classList.contains('safari-fullscreen-active')) {
        if (gameFrame && gameFrame.contentWindow) {
          try {
            gameFrame.contentWindow.postMessage({ type: 'PAUSE_GAME' }, '*');
          } catch (_) {}
        }

        const isPortraitOrMobile =
          window.innerWidth <= 900 ||
          window.innerHeight > window.innerWidth ||
          /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

        if (isPortraitOrMobile && mobileOverlay) {
          mobileOverlay.style.display = 'flex';
          const btnText = mobileOverlay.querySelector('.btn-mobile-play span');
          if (btnText) btnText.textContent = '▶ RESUME GAME IN FULLSCREEN';
          const overlayTitle = mobileOverlay.querySelector('h2');
          if (overlayTitle) overlayTitle.textContent = 'GAME PAUSED';
        }
      }
    }

    document.addEventListener('fullscreenchange', handleFullscreenChange);
    document.addEventListener('webkitfullscreenchange', handleFullscreenChange);

    if (btnFullscreen) btnFullscreen.addEventListener('click', launchLandscapeFullscreen);
    if (btnLaunchMobile) btnLaunchMobile.addEventListener('click', launchLandscapeFullscreen);
    if (btnExitSafari) btnExitSafari.addEventListener('click', exitSafariFullscreen);

    window.addEventListener('message', (event) => {
      if (!event.data) return;

      if (event.data.type === 'DINO_GAME_OVER' || event.data.type === 'STATS_UPDATE') {
        if (event.data.highScore) {
          const currentHigh = Number(localStorage.getItem('dino_high_score') || 0);
          if (event.data.highScore > currentHigh) {
            localStorage.setItem('dino_high_score', event.data.highScore.toString());
          }
        }
        if (event.data.coins !== undefined) {
          localStorage.setItem('dino_coins', event.data.coins.toString());
        }
        updateStatsDisplay();
      }
    });
  });
</script>

<style>
  .game-section {
    padding: 30px 0 50px;
    text-align: center;
  }

  .main-title {
    font-size: clamp(26px, 5.5vw, 48px);
    font-weight: 900;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: clamp(13px, 3.2vw, 17px);
    max-width: 650px;
    margin: 0 auto 24px;
    padding: 0 16px;
  }

  .game-wrapper {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(0, 229, 255, 0.1);
    margin-bottom: 30px;
  }

  .game-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid var(--border-card);
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    background-color: var(--accent-green);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-green);
  }

  .toolbar-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--text-muted);
  }

  .tool-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-main);
    border: 1px solid var(--border-card);
    padding: 6px 14px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tool-btn:hover {
    background: var(--accent-cyan);
    color: #000;
  }

  .game-frame-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .game-frame-box iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Mobile Play Overlay */
  .mobile-overlay {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(11, 15, 25, 0.96);
    backdrop-filter: blur(16px);
    z-index: 10;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .overlay-card {
    max-width: 380px;
    text-align: center;
  }

  .overlay-icon {
    font-size: 48px;
    display: block;
    margin-bottom: 12px;
  }

  .overlay-card h2 {
    font-size: 20px;
    font-weight: 900;
    margin-bottom: 8px;
    color: var(--text-main);
    letter-spacing: 1px;
  }

  .overlay-card p {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .btn-mobile-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 16px 24px;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-magenta));
    color: #0B0F19;
    font-weight: 900;
    font-size: 15px;
    letter-spacing: 1.2px;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 229, 255, 0.35);
    transition: transform 0.2s ease;
  }

  .btn-mobile-play:active {
    transform: scale(0.97);
  }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    padding: 18px;
    text-align: center;
  }

  .stat-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .stat-value {
    font-size: 22px;
    font-weight: 900;
    color: var(--accent-gold);
  }

  /* Safari iOS Viewport Fullscreen Mode */
  .btn-exit-safari {
    display: none;
    position: fixed;
    top: 12px;
    right: 12px;
    z-index: 1000005;
    background: rgba(0, 0, 0, 0.85);
    color: var(--accent-cyan);
    border: 1px solid var(--accent-cyan);
    padding: 8px 16px;
    border-radius: 20px;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 1px;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0, 229, 255, 0.4);
  }

  .game-wrapper.safari-fullscreen-active {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 1000000 !important;
    border-radius: 0 !important;
    margin: 0 !important;
    border: none !important;
    background: #000 !important;
  }

  .game-wrapper.safari-fullscreen-active .game-toolbar {
    display: none !important;
  }

  .game-wrapper.safari-fullscreen-active .game-frame-box {
    height: 100vh !important;
    aspect-ratio: auto !important;
  }

  .game-wrapper.safari-fullscreen-active .btn-exit-safari {
    display: block !important;
  }

  /* Responsive Rules for Mobile Devices & Portrait Mode */
  @media (max-width: 900px), (orientation: portrait) {
    .mobile-overlay {
      display: flex !important;
    }

    .toolbar-title {
      font-size: 11px;
    }

    .tool-btn span {
      display: none;
    }

    .game-frame-box iframe {
      display: none !important;
    }

    .game-wrapper.safari-fullscreen-active iframe {
      display: block !important;
    }
  }
</style>
