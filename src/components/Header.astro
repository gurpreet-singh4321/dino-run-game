---
interface Props {
  activePage?: 'play' | 'guide' | 'epochs' | 'skins' | 'faq' | 'about' | 'contact' | 'privacy' | 'terms';
}

const { activePage = 'play' } = Astro.props;
---

<header class="navbar">
  <div class="nav-container">
    <a href="/" class="logo-box">
      <span class="logo-icon">🦖</span>
      <span class="logo-title">DINO RUN</span>
      <span class="epochs-badge">EPOCHS</span>
    </a>

    <nav class="nav-links desktop-nav">
      <a href="/" class={`nav-link ${activePage === 'play' ? 'active' : ''}`}>🎮 Play Game</a>
      <a href="/guide" class={`nav-link ${activePage === 'guide' ? 'active' : ''}`}>📖 Guide & Tips</a>
      <a href="/epochs" class={`nav-link ${activePage === 'epochs' ? 'active' : ''}`}>🌍 7 Epochs</a>
      <a href="/skins" class={`nav-link ${activePage === 'skins' ? 'active' : ''}`}>🦎 Skins</a>
      <a href="/faq" class={`nav-link ${activePage === 'faq' ? 'active' : ''}`}>❓ FAQ</a>
      <a href="/about" class={`nav-link ${activePage === 'about' ? 'active' : ''}`}>ℹ️ About</a>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button id="mobile-menu-toggle" class="mobile-toggle" aria-label="Toggle navigation menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-nav" class="mobile-nav">
    <a href="/" class={`mobile-link ${activePage === 'play' ? 'active' : ''}`}>🎮 Play Game</a>
    <a href="/guide" class={`mobile-link ${activePage === 'guide' ? 'active' : ''}`}>📖 Strategy Guide</a>
    <a href="/epochs" class={`mobile-link ${activePage === 'epochs' ? 'active' : ''}`}>🌍 7 Epochs Lore</a>
    <a href="/skins" class={`mobile-link ${activePage === 'skins' ? 'active' : ''}`}>🦎 Dinosaur Skins</a>
    <a href="/faq" class={`mobile-link ${activePage === 'faq' ? 'active' : ''}`}>❓ FAQ & Help</a>
    <a href="/about" class={`mobile-link ${activePage === 'about' ? 'active' : ''}`}>ℹ️ About Us</a>
    <a href="/contact" class={`mobile-link ${activePage === 'contact' ? 'active' : ''}`}>✉️ Contact Us</a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      mobileNav.classList.toggle('open');
    });
  }
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(7, 10, 18, 0.92);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-card);
    padding: 14px 0;
    transition: all 0.3s ease;
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3.5vw, 40px);
  }

  .logo-box {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    cursor: pointer;
  }

  .logo-icon {
    font-size: 26px;
    line-height: 1;
    display: flex;
    align-items: center;
  }

  .logo-title {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 1.5px;
    color: #FFFFFF;
    line-height: 1;
  }

  .epochs-badge {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-magenta));
    color: #070A12;
    padding: 5px 11px;
    border-radius: 20px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 10px rgba(0, 229, 255, 0.25);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-link {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 14.5px;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .nav-link:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-link.active {
    color: var(--accent-cyan);
    background: rgba(0, 229, 255, 0.1);
    border: 1px solid rgba(0, 229, 255, 0.25);
  }

  .mobile-toggle {
    display: none;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-card);
    color: #FFFFFF;
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    background: rgba(14, 20, 36, 0.98);
    border-bottom: 1px solid var(--border-card);
    padding: 16px 24px;
    gap: 10px;
  }

  .mobile-nav.open {
    display: flex;
  }

  .mobile-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .mobile-link:hover, .mobile-link.active {
    color: var(--accent-cyan);
    background: rgba(0, 229, 255, 0.1);
  }

  @media (max-width: 980px) {
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
  }
</style>
