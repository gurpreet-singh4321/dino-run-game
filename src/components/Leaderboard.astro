---
---

<section id="leaderboard" class="leaderboard-section">
  <div class="section-container">
    <div class="title-box">
      <h2 class="section-title">GLOBAL LEADERBOARD <span class="badge-coming-soon">COMING SOON</span></h2>
      <p class="section-subtitle">Online cloud leaderboards will launch in the next update! Track your local personal bests below.</p>
    </div>

    <div class="leaderboard-card">
      <div class="leaderboard-header">
        <span>RANK</span>
        <span>PLAYER</span>
        <span>HIGH SCORE</span>
        <span>COINS</span>
      </div>

      <div class="leaderboard-body">
        <div class="leaderboard-row top-rank">
          <span class="rank-badge rank-1">#1</span>
          <div class="player-info">
            <span class="player-name">Your Local Best 🏆</span>
            <span class="badge-active">ACTIVE SESSION</span>
          </div>
          <span id="lb-local-score" class="player-score">0</span>
          <span id="lb-local-coins" class="player-coins">🪙 0</span>
        </div>

        <div class="leaderboard-row sample">
          <span class="rank-badge rank-2">#2</span>
          <div class="player-info">
            <span class="player-name">Global Champion #1</span>
            <span class="badge-guest">PREVIEW</span>
          </div>
          <span class="player-score">48,920</span>
          <span class="player-coins">🪙 340</span>
        </div>

        <div class="leaderboard-row sample">
          <span class="rank-badge rank-3">#3</span>
          <div class="player-info">
            <span class="player-name">Cosmic Runner</span>
            <span class="badge-guest">PREVIEW</span>
          </div>
          <span class="player-score">35,400</span>
          <span class="player-coins">🪙 280</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lbScore = document.getElementById('lb-local-score');
    const lbCoins = document.getElementById('lb-local-coins');

    function syncLeaderboard() {
      const highScore = localStorage.getItem('dino_high_score') || '0';
      const coins = localStorage.getItem('dino_coins') || '0';

      if (lbScore) lbScore.textContent = Number(highScore).toLocaleString();
      if (lbCoins) lbCoins.textContent = `🪙 ${Number(coins).toLocaleString()}`;
    }

    syncLeaderboard();
    window.addEventListener('message', syncLeaderboard);
  });
</script>

<style>
  .leaderboard-section {
    padding: 80px 0;
    border-top: 1px solid var(--border-card);
  }

  .title-box {
    text-align: center;
    margin-bottom: 40px;
  }

  .section-title {
    font-size: 36px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .badge-coming-soon {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    background: linear-gradient(135deg, var(--accent-magenta), var(--accent-gold));
    color: #0B0F19;
    padding: 6px 14px;
    border-radius: 20px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }

  .section-subtitle {
    color: var(--text-muted);
    font-size: 16px;
    margin-top: 8px;
  }

  .leaderboard-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 850px;
    margin: 0 auto;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
  }

  .leaderboard-header {
    display: grid;
    grid-template-columns: 80px 1fr 150px 130px;
    padding: 16px 24px;
    background: rgba(0, 0, 0, 0.5);
    font-size: 12px;
    font-weight: 800;
    color: var(--text-muted);
    letter-spacing: 1.5px;
    border-bottom: 1px solid var(--border-card);
  }

  .leaderboard-row {
    display: grid;
    grid-template-columns: 80px 1fr 150px 130px;
    padding: 20px 24px;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: background 0.2s ease;
  }

  .leaderboard-row:hover {
    background: rgba(0, 229, 255, 0.05);
  }

  .rank-badge {
    font-size: 18px;
    font-weight: 900;
  }

  .rank-1 { color: #FFD700; }
  .rank-2 { color: #C0C0C0; }
  .rank-3 { color: #CD7F32; }

  .player-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .player-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-main);
  }

  .badge-active {
    font-size: 10px;
    font-weight: 800;
    background: rgba(0, 230, 118, 0.15);
    color: var(--accent-green);
    border: 1px solid rgba(0, 230, 118, 0.3);
    padding: 2px 8px;
    border-radius: 12px;
  }

  .badge-guest {
    font-size: 10px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    padding: 2px 8px;
    border-radius: 12px;
  }

  .player-score {
    font-size: 18px;
    font-weight: 900;
    color: var(--accent-gold);
  }

  .player-coins {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-main);
  }
</style>
