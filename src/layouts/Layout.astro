---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	ogType?: string;
	articleData?: {
		headline: string;
		datePublished: string;
		dateModified: string;
		authorName: string;
		description: string;
	};
}

const { 
	title = "Dino Run Epochs - Play Free 60FPS Infinite Dinosaur Runner Online",
	description = "Play Dino Run Epochs online for free. The ultimate 60FPS evolution of the classic Chrome T-Rex runner with 6 procedural biomes, Rive vector models, dynamic speed physics, and zero install.",
	canonicalPath = "",
	ogType = "website",
	articleData
} = Astro.props;

const siteRoot = "https://dinorunepochs.com";
const canonicalUrl = canonicalPath ? `${siteRoot}${canonicalPath}` : siteRoot;

const structuredDataOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Dino Run Epochs Studio",
  "url": siteRoot,
  "logo": `${siteRoot}/assets/app_icon.png`,
  "sameAs": [
    "https://github.com/mrprewsh",
    "https://twitter.com/dinorunepochs"
  ]
};

const structuredDataGame = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  "name": "Dino Run Epochs",
  "url": siteRoot,
  "description": description,
  "genre": ["Arcade", "Endless Runner", "Action", "Platformer"],
  "playMode": "SinglePlayer",
  "gamePlatform": ["Web Browser", "Mobile Browser", "Desktop"],
  "applicationCategory": "Game",
  "operatingSystem": "Any (WebAssembly)",
  "inLanguage": "en",
  "author": {
    "@type": "Organization",
    "name": "Dino Run Epochs Studio"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  }
};

const structuredDataFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Dino Run Epochs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dino Run Epochs is a modern, high-octane 60FPS evolution of the classic Chrome offline dinosaur game. Built with Flutter, Flame Engine, and WebAssembly, it features 6 procedural atmospheric eras (Desert, Monsoon, Forest, Ice Age, Volcano, and Cosmos), dynamic velocity physics, and customizable Rive vector bone skins."
      }
    },
    {
      "@type": "Question",
      "name": "How do Epoch Transitions work in Dino Run Epochs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every 4,500 score points (~3 to 4 minutes of continuous survival), the game triggers an atmospheric transition. Over a 3.5-second sine wave transition, weather fog sweeps in while sky and ground shaders dynamically interpolate to the next era."
      }
    },
    {
      "@type": "Question",
      "name": "How to play Dino Run Epochs on desktop and mobile?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On Desktop, press the Spacebar or Up Arrow key to jump, and the Down Arrow key to duck. On Mobile devices, tap anywhere on the screen to jump."
      }
    },
    {
      "@type": "Question",
      "name": "Is Dino Run Epochs free to play?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Dino Run Epochs is 100% free and unblocked, requiring zero downloads or installation."
      }
    }
  ]
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
		
		<!-- Primary SEO Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content="Dino Run Epochs, Chrome dinosaur game, T-Rex runner online, endless runner game, play dino runner unblocked, 60fps web dino game, Flutter Flame web game, prehistoric arcade game" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="author" content="Dino Run Epochs" />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Open Graph / Facebook / Discord -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/assets/app_icon.png" />
		<meta property="og:site_name" content="Dino Run Epochs" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="/assets/app_icon.png" />

		<!-- Mobile & App Icons -->
		<link rel="icon" type="image/png" href="/assets/app_icon.png" />
		<link rel="apple-touch-icon" href="/assets/app_icon.png" />
		<meta name="theme-color" content="#07090e" />

		<!-- Schema.org JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredDataOrg)} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredDataGame)} />
		<script type="application/ld+json" set:html={JSON.stringify(structuredDataFaq)} />
		{articleData && (
			<script type="application/ld+json" set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "TechArticle",
				"headline": articleData.headline,
				"description": articleData.description,
				"url": canonicalUrl,
				"image": `${siteRoot}/assets/app_icon.png`,
				"datePublished": articleData.datePublished,
				"dateModified": articleData.dateModified,
				"author": {
					"@type": "Person",
					"name": articleData.authorName
				},
				"publisher": structuredDataOrg
			})} />
		)}

		<!-- Vercel Speed Insights -->
		<script is:inline>
			window.si = window.si || function () { (window.siq = window.siq || []).push(arguments); };
		</script>
		<script defer src="/_vercel/speed-insights/script.js"></script>

		<!-- Vercel Web Analytics -->
		<script is:inline>
			window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
		</script>
		<script defer src="/_vercel/insights/script.js"></script>

		<!-- Google AdSense -->
		<meta name="google-adsense-account" content="ca-pub-6461062896377292" />
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6461062896377292" crossorigin="anonymous"></script>

		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="bg-[#07090e] text-slate-100 min-h-[100dvh] font-['Outfit',sans-serif] selection:bg-amber-500/30 selection:text-amber-200 antialiased relative">
		<!-- Ambient Grid Background -->
		<div class="fixed inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none z-0" />
		
		<div class="relative z-10">
			<slot />
		</div>
	</body>
</html>
