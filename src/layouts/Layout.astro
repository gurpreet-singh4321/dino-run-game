---
import SpeedInsights from '@vercel/speed-insights/astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	canonicalUrl?: string;
}

const { 
	title = "Dino Run: Epochs | Play Free Online Endless Runner Game",
	description = "Play Dino Run: Epochs online for free! Run across 7 unique prehistoric, volcanic, cyberpunk, and cosmos biomes in this high-speed 2D endless runner.",
	keywords = "Dino Run, Dino Run Epochs, Dino Runner Game, Dinosaur Game, Free Online Games, Endless Runner, Play Dino Game, Retro Games, Browser Games",
	ogImage = "/game/icons/Icon-512.png",
	canonicalUrl = Astro.url.href
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
		<meta http-equiv="Pragma" content="no-cache" />
		<meta http-equiv="Expires" content="0" />
		<link rel="icon" type="image/png" href="/game/favicon.png" />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="keywords" content={keywords} />
		<meta name="google-adsense-account" content="ca-pub-6461062896377292" />
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6461062896377292" crossorigin="anonymous"></script>

		<!-- OpenGraph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

		<!-- Schema.org VideoGame & WebSite Structured Data -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebSite",
					"@id": "https://dino-run-epochs.vercel.app/#website",
					"url": "https://dino-run-epochs.vercel.app/",
					"name": "Dino Run: Epochs",
					"description": "An epic 2D endless dinosaur runner across 7 time epochs built with Flutter, Flame Engine, and Astro JS.",
					"publisher": {
						"@type": "Organization",
						"name": "Dino Run Studios"
					}
				},
				{
					"@type": "SoftwareApplication",
					"name": "Dino Run: Epochs",
					"operatingSystem": "Web, Android, iOS, Windows, macOS",
					"applicationCategory": "GameApplication",
					"genre": "Endless Runner",
					"ratingValue": "4.9",
					"ratingCount": "1420",
					"offers": {
						"@type": "Offer",
						"price": "0",
						"priceCurrency": "USD"
					},
					"description": "Play Dino Run: Epochs online for free! Run across 7 dynamic biomes from Jurassic to Cosmos Zero-G with instant 60 FPS gameplay."
				}
			]
		}
		</script>
	</head>
	<body>
		<slot />
		<SpeedInsights />
		<Analytics />
	</body>
</html>

<style is:global>
	:root {
		--bg-dark: #070A12;
		--bg-surface: #0E1424;
		--bg-card: rgba(18, 26, 46, 0.85);
		--bg-card-hover: rgba(28, 40, 70, 0.95);
		--border-card: rgba(255, 255, 255, 0.12);
		--border-subtle: rgba(255, 255, 255, 0.06);
		--accent-cyan: #00E5FF;
		--accent-magenta: #E040FB;
		--accent-gold: #FFD54F;
		--accent-green: #00E676;
		--accent-orange: #FF7043;
		--text-main: #F1F5F9;
		--text-muted: #94A3B8;
		--text-dim: #64748B;
		--font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
		--font-mono: 'JetBrains Mono', monospace;
		--radius-lg: 20px;
		--radius-md: 14px;
		--radius-sm: 8px;
		--shadow-card: 0 12px 36px rgba(0, 0, 0, 0.4);
		--shadow-glow: 0 0 25px rgba(0, 229, 255, 0.15);
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
		scroll-behavior: smooth;
	}

	body {
		background-color: var(--bg-dark);
		color: var(--text-main);
		font-family: var(--font-family);
		line-height: 1.65;
		overflow-x: hidden;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background-image: 
			radial-gradient(circle at 10% 10%, rgba(0, 229, 255, 0.07) 0%, transparent 45%),
			radial-gradient(circle at 90% 60%, rgba(224, 64, 251, 0.07) 0%, transparent 45%),
			radial-gradient(circle at 50% 90%, rgba(255, 213, 79, 0.04) 0%, transparent 40%);
	}

	main {
		flex: 1;
	}

	.section-container {
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		padding: 0 clamp(16px, 3.5vw, 40px);
	}

	.gradient-text {
		background: linear-gradient(135deg, var(--accent-cyan), var(--accent-magenta), var(--accent-gold));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.gradient-text-cyan {
		background: linear-gradient(135deg, var(--accent-cyan), #80D8FF);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.gradient-text-gold {
		background: linear-gradient(135deg, var(--accent-gold), var(--accent-orange));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	/* Article and Content Typography */
	.content-page {
		padding: 60px 0 100px;
	}

	.content-hero {
		text-align: center;
		margin-bottom: 50px;
	}

	.content-hero .badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		padding: 6px 14px;
		border-radius: 30px;
		background: rgba(0, 229, 255, 0.12);
		color: var(--accent-cyan);
		border: 1px solid rgba(0, 229, 255, 0.3);
		margin-bottom: 16px;
	}

	.content-hero h1 {
		font-size: clamp(32px, 5vw, 52px);
		font-weight: 900;
		line-height: 1.15;
		margin-bottom: 16px;
		letter-spacing: -0.5px;
	}

	.content-hero p {
		font-size: clamp(16px, 2vw, 20px);
		color: var(--text-muted);
		max-width: 820px;
		margin: 0 auto;
	}

	.content-body {
		max-width: 960px;
		margin: 0 auto;
		font-size: 16.5px;
		color: #CBD5E1;
	}

	.content-body h2 {
		font-size: clamp(24px, 3vw, 32px);
		font-weight: 800;
		color: #FFFFFF;
		margin: 48px 0 18px;
		padding-bottom: 10px;
		border-bottom: 1px solid var(--border-subtle);
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.content-body h3 {
		font-size: clamp(19px, 2.4vw, 23px);
		font-weight: 700;
		color: #F8FAFC;
		margin: 32px 0 12px;
	}

	.content-body p {
		margin-bottom: 20px;
		line-height: 1.75;
	}

	.content-body ul, .content-body ol {
		margin: 0 0 24px 24px;
		line-height: 1.75;
	}

	.content-body li {
		margin-bottom: 10px;
	}

	.content-body strong {
		color: #FFFFFF;
		font-weight: 700;
	}

	.content-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: var(--radius-md);
		padding: 32px;
		margin: 28px 0;
		box-shadow: var(--shadow-card);
	}

	.info-callout {
		background: rgba(0, 229, 255, 0.08);
		border-left: 4px solid var(--accent-cyan);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
		padding: 20px 24px;
		margin: 28px 0;
	}

	.info-callout p {
		margin-bottom: 0;
		color: #E2E8F0;
	}

	.info-callout strong {
		color: var(--accent-cyan);
	}

	.table-wrapper {
		overflow-x: auto;
		margin: 28px 0;
		border-radius: var(--radius-md);
		border: 1px solid var(--border-card);
	}

	table {
		width: 100%;
		border-collapse: collapse;
		text-align: left;
		font-size: 15px;
	}

	th, td {
		padding: 16px 20px;
		border-bottom: 1px solid var(--border-subtle);
	}

	th {
		background: rgba(14, 20, 36, 0.95);
		color: var(--accent-cyan);
		font-weight: 800;
		text-transform: uppercase;
		font-size: 13px;
		letter-spacing: 1px;
	}

	tr:last-child td {
		border-bottom: none;
	}

	tr:hover td {
		background: rgba(255, 255, 255, 0.02);
	}
</style>
