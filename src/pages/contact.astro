---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Contact Us & Support | Dino Run: Epochs" 
  description="Have questions, feedback, or a bug report for Dino Run: Epochs? Reach out to our development and support team directly."
>
  <Header activePage="contact" />

  <main class="content-page">
    <div class="section-container">
      <div class="content-hero">
        <span class="badge">Player Support</span>
        <h1>Contact & <span class="gradient-text">Feedback</span></h1>
        <p>We'd love to hear from you! Reach out with suggestions, gameplay feedback, business inquiries, or bug reports.</p>
      </div>

      <div class="content-body">
        <div class="contact-grid">
          <!-- Support Card 1: Direct Inquiries -->
          <div class="content-card">
            <h3>📧 Direct Email Support</h3>
            <p>For general inquiries, partnership proposals, and support questions, contact us via email:</p>
            <p style="margin-bottom: 8px;">
              <strong>General Support:</strong> <a href="mailto:support@dinorunepochs.com" style="color: var(--accent-cyan);">support@dinorunepochs.com</a>
            </p>
            <p style="margin-bottom: 8px;">
              <strong>Business & Press:</strong> <a href="mailto:press@dinorunepochs.com" style="color: var(--accent-cyan);">press@dinorunepochs.com</a>
            </p>
            <p style="margin-bottom: 0;">
              <strong>Privacy & Legal:</strong> <a href="mailto:privacy@dinorunepochs.com" style="color: var(--accent-cyan);">privacy@dinorunepochs.com</a>
            </p>
          </div>

          <!-- Support Card 2: Bug Reporting -->
          <div class="content-card" id="bug-report">
            <h3>🐛 Bug Reports & Technical Issues</h3>
            <p>Encountered a glitch or frame drop? Please include the following details in your email to help us diagnose and patch it quickly:</p>
            <ul>
              <li><strong>Device & OS:</strong> (e.g., iPhone 15 iOS 18, Windows 11 PC, Galaxy S24 Android 14)</li>
              <li><strong>Browser:</strong> (e.g., Chrome v128, Safari, Firefox, Edge)</li>
              <li><strong>Biome Encountered:</strong> (e.g., Volcanic Wasteland, Cosmos Zero-G)</li>
              <li><strong>Description:</strong> A brief description of what happened and steps to reproduce.</li>
            </ul>
          </div>
        </div>

        <h2>Frequently Requested Help</h2>
        <div class="info-callout">
          <p><strong>Looking for Quick Answers?</strong> Before sending an email, check out our comprehensive <a href="/faq" style="color: var(--accent-cyan); font-weight: 700;">FAQ & Troubleshooting Page</a> for immediate solutions regarding mobile fullscreen controls, audio issues, and local high score saves.</p>
        </div>

        <div class="content-card">
          <h3>🎮 Community Feedback & Suggestions</h3>
          <p>
            Have a brilliant idea for a new Time Epoch, a crazy dinosaur skin, or a new powerup mechanic? We love player-driven development! Drop us an email with the subject <code>[Biome Idea]</code> or <code>[Skin Concept]</code> and our design team will review it for upcoming releases.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 30px;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
